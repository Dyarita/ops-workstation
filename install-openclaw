#!/usr/bin/env bash
# OpenClaw on a VM. The host does not run this.
#   sudo ./install-openclaw --headless --task web
# From the host, send work with: ops fleet
set -euo pipefail

_src="${BASH_SOURCE[0]}"
if [[ "$_src" != /* ]]; then
  _src="$(pwd)/${_src#./}"
fi
ROOT="$(cd "$(dirname "$(readlink -f "$_src")")" && pwd)"

# shellcheck source=lib/common.sh
source "${ROOT}/lib/common.sh"
# shellcheck source=lib/platform.sh
source "${ROOT}/lib/platform.sh"

usage() {
  cat <<'EOF'
Uso: sudo ./install-openclaw --headless --task web|markets|prices|social

Corré esto en la VM, no en el host. El host no instala OpenClaw.
Desde el host se mandan instrucciones con: ops fleet
EOF
}

need_root=1
for arg in "$@"; do
  case "$arg" in
    -h|--help|--gui) need_root=0 ;;
  esac
done
if [[ "$need_root" == 1 && "$(id -u)" -ne 0 ]]; then
  exec sudo --preserve-env=DISPLAY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,ANTHROPIC_API_KEY \
    bash "${ROOT}/install-openclaw" "$@"
fi

MODE="worker"
TASK=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --headless) MODE="worker"; shift ;;
    --gui)
      cat <<'EOF'
En el host no se instala OpenClaw.
Abrí el panel y mandá la instrucción a la VM:

  ops fleet

EOF
      exit 0
      ;;
    --task) TASK="${2:-}"; shift 2 ;;
    --no-open) shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "Opción desconocida: $1" ;;
  esac
done

ops_init
detect_pm

FAILURES=()
note_failure() {
  FAILURES+=("$1	$2")
  warn "$1: $2"
}

case "$TASK" in
  ""|web|markets|prices|social) ;;
  *) die "Tarea desconocida: $TASK (web, markets, prices, social)" ;;
esac
if [[ "$MODE" == "worker" && -z "$TASK" ]]; then
  TASK="web"
  warn "Sin --task: esta VM queda como web. Cambialo desde ops fleet."
fi

as_user() {
  if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
      runuser -u "$TARGET_USER" -- env HOME="$TARGET_HOME" ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" "$@"
    else
      runuser -u "$TARGET_USER" -- env HOME="$TARGET_HOME" "$@"
    fi
  else
    "$@"
  fi
}

user_shell() {
  as_user bash -lc "$1"
}

log "OpenClaw · ${MODE} · usuario ${TARGET_USER} · ${OS_PRETTY} · ${PM}"

install_cli() {
  log "Instalando CLI (instalador upstream, sin preguntas)"
  if user_shell 'curl -fsSL --proto "=https" --tlsv1.2 https://openclaw.ai/install.sh | bash -s -- --no-onboard --no-prompt'; then
    ok "CLI instalada"
  else
    note_failure openclaw "el instalador upstream falló; el resto sigue"
    return 1
  fi
}

setup_gateway() {
  if ! user_shell 'command -v openclaw >/dev/null'; then
    note_failure gateway "no está el comando openclaw"
    return 0
  fi
  if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    log "Onboarding con la API key del entorno"
    if ! user_shell 'openclaw onboard --non-interactive --accept-risk --install-daemon --daemon-runtime node --gateway-bind loopback --auth-choice apiKey --anthropic-api-key "$ANTHROPIC_API_KEY" --skip-health'; then
      note_failure gateway "onboard con API key falló"
    fi
  else
    log "Baseline local, sin pedir una key en la VM"
    user_shell 'openclaw setup --baseline' || note_failure gateway "setup --baseline falló"
    user_shell 'openclaw gateway install' || note_failure gateway "gateway install falló; se puede reintentar con: openclaw gateway install"
  fi
  if [[ "$(id -u)" -eq 0 ]]; then
    loginctl enable-linger "$TARGET_USER" 2>/dev/null || note_failure linger "loginctl enable-linger falló; el gateway puede caerse al cerrar sesión"
  fi
}

write_task() {
  [[ "$MODE" == "worker" ]] || return 0
  local src="${ROOT}/fleet/tasks/${TASK}.md"
  local dest="${TARGET_HOME}/.openclaw/workspace"
  [[ -f "$src" ]] || { note_failure task "no existe ${src}"; return 0; }
  mkdir -p "$dest"
  cp -a "$src" "${dest}/TASK.md"
  printf '%s\n' "$TASK" >"${dest}/TASK_NAME"
  own "$dest"
  ok "Tarea ${TASK} en ${dest}/TASK.md"
}

install_cli || true
setup_gateway
write_task

printf '\n'
if [[ "${#FAILURES[@]}" -eq 0 ]]; then
  ok "OpenClaw listo (${MODE})"
else
  warn "Terminó con ${#FAILURES[@]} pendientes:"
  for row in "${FAILURES[@]}"; do
    printf '  %s\n' "$row"
  done
fi
cat <<EOF

VM lista, tarea ${TASK}. OpenClaw corre acá, no en el host.
Desde el host: ops fleet
EOF
