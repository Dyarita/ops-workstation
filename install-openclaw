#!/usr/bin/env bash
# OpenClaw on this machine, without a desktop on every VM.
#   sudo ./install-openclaw --headless --task web
#   sudo ./install-openclaw --gui
# A headless VM gets the gateway and a task file. The GUI stays on the operator.
set -euo pipefail

_src="${BASH_SOURCE[0]}"
if [[ "$_src" != /* ]]; then
  _src="$(pwd)/${_src#./}"
fi
ROOT="$(cd "$(dirname "$(readlink -f "$_src")")" && pwd)"

# shellcheck source=lib/common.sh
source "${ROOT}/lib/common.sh"
# shellcheck source=lib/platform.sh
source "${ROOT}/lib/platform.sh"

usage() {
  cat <<'EOF'
Uso: sudo ./install-openclaw [--headless|--gui] [--task web|markets|prices|social]

  --headless   VM de trabajo: gateway, sin escritorio
  --gui        Esta máquina abre el panel (app + flota)
  --task NAME  Qué hace esta VM. En --gui se ignora
  --no-open    Instala pero no abre la interfaz
  -h, --help

Sin flags: --gui si hay DISPLAY, si no --headless.

La GUI no va en cada VM. Desde la workstation:
  ops fleet
EOF
}

need_root=1
for arg in "$@"; do
  case "$arg" in
    -h|--help) need_root=0 ;;
  esac
done
if [[ "$need_root" == 1 && "$(id -u)" -ne 0 ]]; then
  exec sudo --preserve-env=DISPLAY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,ANTHROPIC_API_KEY \
    bash "${ROOT}/install-openclaw" "$@"
fi

MODE="auto"
TASK=""
OPEN_UI=1
while [[ $# -gt 0 ]]; do
  case "$1" in
    --headless) MODE="worker"; shift ;;
    --gui) MODE="operator"; shift ;;
    --task) TASK="${2:-}"; shift 2 ;;
    --no-open) OPEN_UI=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "Opción desconocida: $1" ;;
  esac
done

ops_init
detect_pm

FAILURES=()
note_failure() {
  FAILURES+=("$1	$2")
  warn "$1: $2"
}

if [[ "$MODE" == "auto" ]]; then
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    MODE="operator"
  else
    MODE="worker"
  fi
fi

case "$TASK" in
  ""|web|markets|prices|social) ;;
  *) die "Tarea desconocida: $TASK (web, markets, prices, social)" ;;
esac
if [[ "$MODE" == "worker" && -z "$TASK" ]]; then
  TASK="web"
  warn "Sin --task: esta VM queda como web. Cambialo desde ops fleet."
fi

as_user() {
  if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
      runuser -u "$TARGET_USER" -- env HOME="$TARGET_HOME" ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" "$@"
    else
      runuser -u "$TARGET_USER" -- env HOME="$TARGET_HOME" "$@"
    fi
  else
    "$@"
  fi
}

user_shell() {
  as_user bash -lc "$1"
}

log "OpenClaw · ${MODE} · usuario ${TARGET_USER} · ${OS_PRETTY} · ${PM}"

install_cli() {
  log "Instalando CLI (instalador upstream, sin preguntas)"
  if user_shell 'curl -fsSL --proto "=https" --tlsv1.2 https://openclaw.ai/install.sh | bash -s -- --no-onboard --no-prompt'; then
    ok "CLI instalada"
  else
    note_failure openclaw "el instalador upstream falló; el resto sigue"
    return 1
  fi
}

setup_gateway() {
  if ! user_shell 'command -v openclaw >/dev/null'; then
    note_failure gateway "no está el comando openclaw"
    return 0
  fi
  if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    log "Onboarding con la API key del entorno"
    if ! user_shell 'openclaw onboard --non-interactive --accept-risk --install-daemon --daemon-runtime node --gateway-bind loopback --auth-choice apiKey --anthropic-api-key "$ANTHROPIC_API_KEY" --skip-health'; then
      note_failure gateway "onboard con API key falló"
    fi
  else
    log "Baseline local, sin pedir una key en la VM"
    user_shell 'openclaw setup --baseline' || note_failure gateway "setup --baseline falló"
    user_shell 'openclaw gateway install' || note_failure gateway "gateway install falló; se puede reintentar con: openclaw gateway install"
  fi
  if [[ "$(id -u)" -eq 0 ]]; then
    loginctl enable-linger "$TARGET_USER" 2>/dev/null || note_failure linger "loginctl enable-linger falló; el gateway puede caerse al cerrar sesión"
  fi
}

write_task() {
  [[ "$MODE" == "worker" ]] || return 0
  local src="${ROOT}/fleet/tasks/${TASK}.md"
  local dest="${TARGET_HOME}/.openclaw/workspace"
  [[ -f "$src" ]] || { note_failure task "no existe ${src}"; return 0; }
  mkdir -p "$dest"
  cp -a "$src" "${dest}/TASK.md"
  printf '%s\n' "$TASK" >"${dest}/TASK_NAME"
  own "$dest"
  ok "Tarea ${TASK} en ${dest}/TASK.md"
}

install_gui_app() {
  [[ "$MODE" == "operator" ]] || return 0
  local url tmp json
  case "$MACH" in
    x86_64) asset_re='OpenClaw-.+-amd64\.AppImage$' ;;
    aarch64) asset_re='OpenClaw-.+-arm64\.AppImage$' ;;
    *) note_failure gui "sin AppImage para ${MACH}; uso el Control UI en el browser"; return 0 ;;
  esac
  json="$(curl -fsSL --retry 3 -H "Accept: application/vnd.github+json" \
    https://api.github.com/repos/openclaw/openclaw/releases/latest)" || {
    note_failure gui "no pude leer el release de la app"
    return 0
  }
  if have_cmd jq; then
    url="$(printf '%s\n' "$json" | jq -r --arg re "$asset_re" 'first(.assets[].browser_download_url | select(test($re))) // empty')"
  else
    url="$(printf '%s\n' "$json" | grep -oE 'https://[^"]+AppImage' | grep -E "$asset_re" | head -1 || true)"
  fi
  if [[ -z "$url" ]]; then
    note_failure gui "este release no trae AppImage para ${MACH}; el panel web igual abre"
    return 0
  fi
  log "App ← ${url}"
  tmp="$(mktemp)"
  if curl -fsSL --retry 3 -o "$tmp" "$url"; then
    install -m 0755 "$tmp" "${PREFIX_BIN}/openclaw-gui"
    rm -f "$tmp"
    ok "App en ${PREFIX_BIN}/openclaw-gui"
  else
    rm -f "$tmp"
    note_failure gui "descarga de la AppImage falló"
  fi
}

open_operator_ui() {
  [[ "$MODE" == "operator" && "$OPEN_UI" == 1 ]] || return 0
  local uid runtime
  uid="$(id -u "$TARGET_USER")"
  runtime="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
  if [[ -x "${PREFIX_BIN}/openclaw-gui" && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    as_user env DISPLAY="${DISPLAY:-}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" XDG_RUNTIME_DIR="$runtime" \
      "${PREFIX_BIN}/openclaw-gui" --appimage-extract-and-run >/tmp/openclaw-gui.log 2>&1 &
    ok "App OpenClaw abierta"
  fi
  as_user env DISPLAY="${DISPLAY:-}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" XDG_RUNTIME_DIR="$runtime" \
    python3 "${ROOT}/bin/fleet-gui.py" --open >/tmp/ops-fleet.log 2>&1 &
  ok "Panel de flota en http://127.0.0.1:8765"
}

install_cli || true
setup_gateway
write_task
install_gui_app
open_operator_ui

printf '\n'
if [[ "${#FAILURES[@]}" -eq 0 ]]; then
  ok "OpenClaw listo (${MODE})"
else
  warn "Terminó con ${#FAILURES[@]} pendientes:"
  for row in "${FAILURES[@]}"; do
    printf '  %s\n' "$row"
  done
fi
if [[ "$MODE" == "worker" ]]; then
  cat <<EOF

VM worker, tarea ${TASK}. No hay escritorio acá a propósito.
Desde la workstation: ops fleet
EOF
else
  cat <<EOF

Panel: http://127.0.0.1:8765
Ahí se agregan las VMs, se les asigna la tarea y se abre el gateway de cada una.
EOF
fi
