#!/usr/bin/env bash
# Undo an install snapshot: user configs, login shell, and packages from that run.
set -euo pipefail

_src="${BASH_SOURCE[0]}"
if [[ "$_src" != /* ]]; then
  _src="$(pwd)/${_src#./}"
fi
ROOT="$(cd "$(dirname "$(readlink -f "$_src")")" && pwd)"

# shellcheck source=lib/snapshot.sh
source "${ROOT}/lib/snapshot.sh"

usage() {
  cat <<'EOF'
Uso: sudo ./rollback [snapshot-id]
     sudo ./rollback --list
     sudo ./rollback --files-only

  snapshot-id   Por defecto, el último install
  --files-only  Configs y shell, sin desinstalar paquetes
  --list        Listar snapshots
EOF
}

need_root=1
for arg in "$@"; do
  case "$arg" in
    --list|-h|--help) need_root=0 ;;
  esac
done
if [[ "$need_root" == 1 && "$(id -u)" -ne 0 ]]; then
  exec sudo -- bash "${ROOT}/rollback" "$@"
fi

FILES_ONLY=0
WANT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --files-only) FILES_ONLY=1; shift ;;
    --list)
      ops_init
      list_snapshots
      exit 0
      ;;
    -h|--help) usage; exit 0 ;;
    -*) die "Opción desconocida: $1" ;;
    *) WANT="$1"; shift ;;
  esac
done

ops_init
detect_pm

SNAP="$(resolve_snapshot "$WANT")"
log "Rollback → $(basename "$SNAP") (${TARGET_USER})"

restore_snapshot_files "$SNAP"
rollback_shell "$SNAP"

if [[ "$FILES_ONLY" != "1" ]]; then
  rollback_packages "$SNAP"
else
  warn "Modo files-only: paquetes intactos"
fi

ok "Rollback completado: $(basename "$SNAP")"
printf 'Reinstalar: sudo %s/install\n' "$ROOT"
